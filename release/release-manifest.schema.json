{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local release candidate manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "git_commit",
    "working_tree_dirty",
    "rust_toolchain",
    "built_target",
    "supported_platforms",
    "binary_sha256",
    "benchmark",
    "build_timestamp_nonsemantic",
    "publication_ready",
    "known_limitations",
    "source_inventory_sha256",
    "manifest_role",
    "actually_verified_platforms",
    "platform_validation",
    "artifact_sha256",
    "license",
    "license_notices_sha256",
    "rust_runtime_notices_sha256",
    "signing",
    "sbom",
    "name_clearance",
    "benchmark_scope",
    "local_release_candidate_ready",
    "owner_publication_authorized",
    "ci_provenance",
    "clean_public_repo_ready",
    "technical_publication_ready",
    "platform_validation_scope"
  ],
  "properties": {
    "schema_version": {
      "const": "3"
    },
    "version": {
      "const": "0.1.0"
    },
    "git_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{40}$"
    },
    "working_tree_dirty": {
      "type": "boolean"
    },
    "rust_toolchain": {
      "type": "string",
      "minLength": 1
    },
    "built_target": {
      "enum": [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu"
      ]
    },
    "supported_platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "binary_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "required": [
        "b2ige",
        "b2ige-mcp",
        "b2ige-demo",
        "b2ige-demo-effect",
        "p5-effect-fixture"
      ]
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_version",
        "corpus_hash",
        "semantic_hash",
        "summary"
      ],
      "properties": {
        "benchmark_version": {
          "type": "string"
        },
        "corpus_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "semantic_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "summary": {
          "type": "object",
          "required": [
            "gate_pass",
            "total_cases",
            "false_pass",
            "false_fail"
          ],
          "properties": {
            "gate_pass": {
              "const": true
            },
            "total_cases": {
              "const": 31
            },
            "false_pass": {
              "const": 0
            },
            "false_fail": {
              "const": 0
            }
          }
        }
      }
    },
    "build_timestamp_nonsemantic": {
      "type": "string"
    },
    "publication_ready": {
      "const": false
    },
    "known_limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "source_inventory_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifest_role": {
      "enum": [
        "embedded",
        "release-index"
      ]
    },
    "actually_verified_platforms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "aarch64-apple-darwin",
          "x86_64-apple-darwin",
          "x86_64-unknown-linux-gnu"
        ]
      }
    },
    "platform_validation": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "VERIFIED_NATIVE",
          "CROSS_BUILD_ONLY",
          "EMULATED",
          "NOT_RUN"
        ]
      }
    },
    "artifact_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "license": {
      "const": "Apache-2.0"
    },
    "license_notices_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rust_runtime_notices_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publisher_signed",
        "apple_notarized",
        "status"
      ],
      "properties": {
        "publisher_signed": {
          "const": false
        },
        "apple_notarized": {
          "const": false
        },
        "status": {
          "const": "OWNER_DECISION"
        }
      }
    },
    "sbom": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "GENERATED",
            "NOT_YET_GENERATED"
          ]
        }
      }
    },
    "name_clearance": {
      "type": "object",
      "required": [
        "status",
        "review",
        "final_package_names"
      ],
      "properties": {
        "status": {
          "const": "INCOMPLETE"
        },
        "review": {
          "const": "release/name-clearance-review.md"
        },
        "final_package_names": {
          "type": "null"
        }
      }
    },
    "benchmark_scope": {
      "const": "B2IGE Verify Bench v1; 31 explicit cases; metrics on the benchmark corpus"
    },
    "local_release_candidate_ready": {
      "type": "boolean"
    },
    "owner_publication_authorized": {
      "const": false
    },
    "ci_provenance": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "clean_public_repo_ready": {
      "type": "boolean"
    },
    "technical_publication_ready": {
      "type": "boolean"
    },
    "platform_validation_scope": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
