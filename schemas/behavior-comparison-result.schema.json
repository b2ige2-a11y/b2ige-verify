{
  "$defs": {
    "ApprovalStatus": {
      "enum": [
        "approved",
        "unapproved"
      ],
      "type": "string"
    },
    "Baseline": {
      "additionalProperties": false,
      "properties": {
        "approval": {
          "$ref": "#/$defs/BaselineApproval"
        },
        "baseline_id": {
          "type": "string"
        },
        "created_by": {
          "$ref": "#/$defs/BaselineCreator"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "observation_contract_hash": {
          "type": "string"
        },
        "stability_runs": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "target_revision": {
          "type": "string"
        }
      },
      "required": [
        "baseline_id",
        "target_revision",
        "created_by",
        "approval",
        "observation_contract_hash"
      ],
      "type": "object"
    },
    "BaselineApproval": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/ApprovalStatus"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "BaselineCreator": {
      "enum": [
        "human",
        "policy",
        "imported"
      ],
      "type": "string"
    },
    "BehaviorCase": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "case_id": {
          "type": "string"
        },
        "comparison_policy": {
          "$ref": "#/$defs/ComparisonPolicy"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "fixture": {
          "$ref": "#/$defs/LocalFixture"
        },
        "required_observers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "schema_version": {
          "type": "string"
        },
        "timeout_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "case_id",
        "args",
        "environment",
        "timeout_ms",
        "fixture",
        "comparison_policy",
        "required_observers"
      ],
      "type": "object"
    },
    "BehaviorExperiment": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "$ref": "#/$defs/BehaviorTarget"
        },
        "baseline": {
          "$ref": "#/$defs/Baseline"
        },
        "before": {
          "$ref": "#/$defs/BehaviorTarget"
        },
        "case": {
          "$ref": "#/$defs/BehaviorCase"
        },
        "schema_version": {
          "type": "string"
        },
        "seed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "case",
        "baseline",
        "before",
        "after",
        "seed"
      ],
      "type": "object"
    },
    "BehaviorOutcome": {
      "enum": [
        "DIVERGENCE_PROVEN",
        "NO_DIVERGENCE_FOUND",
        "INCONCLUSIVE",
        "ERROR"
      ],
      "type": "string"
    },
    "BehaviorTarget": {
      "additionalProperties": false,
      "properties": {
        "executable": {
          "type": "string"
        },
        "identity": {
          "description": "SHA-256 of the actual executable bytes, not Git or a mutable label.",
          "type": "string"
        },
        "input_identity": {
          "type": "string"
        }
      },
      "required": [
        "executable",
        "identity",
        "input_identity"
      ],
      "type": "object"
    },
    "ComparisonPolicy": {
      "enum": [
        "process_byte_exact_v1"
      ],
      "type": "string"
    },
    "Divergence": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "$ref": "#/$defs/ObservableValue"
        },
        "after_run_id": {
          "type": "string"
        },
        "after_target_hash": {
          "type": "string"
        },
        "before": {
          "$ref": "#/$defs/ObservableValue"
        },
        "before_run_id": {
          "type": "string"
        },
        "before_target_hash": {
          "type": "string"
        },
        "case_identity": {
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "type": "array"
        },
        "observable": {
          "$ref": "#/$defs/Observable"
        }
      },
      "required": [
        "case_identity",
        "before_run_id",
        "after_run_id",
        "before_target_hash",
        "after_target_hash",
        "observable",
        "before",
        "after",
        "evidence_refs"
      ],
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_hash": {
          "type": "string"
        },
        "evidence_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "evidence_id",
        "evidence_hash"
      ],
      "type": "object"
    },
    "LocalFixture": {
      "additionalProperties": false,
      "properties": {
        "snapshot_identity": {
          "description": "Content/mode/directory snapshot identity, checked before either execution.",
          "type": "string"
        },
        "source": {
          "description": "None creates an empty workspace. stdin remains P1's /dev/null.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "snapshot_identity"
      ],
      "type": "object"
    },
    "Observable": {
      "enum": [
        "exit_code",
        "signal",
        "stdout",
        "stderr"
      ],
      "type": "string"
    },
    "ObservableValue": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "status",
              "type": "string"
            },
            "value": {
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "bytes",
              "type": "string"
            },
            "length": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "sha256": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "sha256",
            "length"
          ],
          "type": "object"
        }
      ]
    },
    "ObservationCoverage": {
      "enum": [
        "complete",
        "partial",
        "unavailable",
        "failed"
      ],
      "type": "string"
    },
    "Replayability": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "available",
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "reason": {
              "type": "string"
            },
            "status": {
              "const": "unavailable",
              "type": "string"
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "RunRecord": {
      "additionalProperties": false,
      "properties": {
        "config_hash": {
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "type": "array"
        },
        "initial_snapshot_identity": {
          "type": "string"
        },
        "input_identity": {
          "type": "string"
        },
        "plan_hash": {
          "type": "string"
        },
        "result_hash": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "working_directory": {
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "result_hash",
        "plan_hash",
        "config_hash",
        "input_identity",
        "initial_snapshot_identity",
        "working_directory",
        "evidence_refs"
      ],
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "contract_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "exploration_budget": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
        }
      },
      "required": [
        "contract_ids",
        "exploration_budget"
      ],
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE",
        "ERROR"
      ],
      "type": "string"
    }
  },
  "$id": "https://b2ige.dev/schemas/verify/behavior-comparison-result.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "after": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunRecord"
        },
        {
          "type": "null"
        }
      ]
    },
    "after_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "authorization_hash": {
      "type": "string"
    },
    "baseline_identity": {
      "description": "Full approved baseline artifact hash; executable identity is separate.",
      "type": "string"
    },
    "baseline_target_identity": {
      "type": "string"
    },
    "before": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunRecord"
        },
        {
          "type": "null"
        }
      ]
    },
    "before_run_id": {
      "description": "None means no durable acquisition was obtained for that side.",
      "type": [
        "string",
        "null"
      ]
    },
    "candidate_identity": {
      "type": "string"
    },
    "case_identity": {
      "type": "string"
    },
    "comparison_id": {
      "type": "string"
    },
    "config_hash": {
      "type": "string"
    },
    "coverage": {
      "additionalProperties": {
        "$ref": "#/$defs/ObservationCoverage"
      },
      "type": "object"
    },
    "divergences": {
      "items": {
        "$ref": "#/$defs/Divergence"
      },
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "type": "array"
    },
    "experiment": {
      "$ref": "#/$defs/BehaviorExperiment"
    },
    "experiment_hash": {
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "outcome": {
      "$ref": "#/$defs/BehaviorOutcome"
    },
    "reason": {
      "type": "string"
    },
    "replayability": {
      "$ref": "#/$defs/Replayability"
    },
    "schema_version": {
      "const": "1",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    }
  },
  "required": [
    "comparison_id",
    "schema_version",
    "case_identity",
    "baseline_identity",
    "baseline_target_identity",
    "candidate_identity",
    "outcome",
    "verdict",
    "reason",
    "divergences",
    "evidence_refs",
    "experiment",
    "experiment_hash",
    "config_hash",
    "authorization_hash",
    "scope",
    "coverage",
    "replayability",
    "limitations"
  ],
  "title": "Behavior Comparison Result v1",
  "type": "object"
}
