{
  "$defs": {
    "ApprovalStatus": {
      "enum": [
        "approved",
        "unapproved"
      ],
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "integrity_hash": {
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "integrity_hash"
      ],
      "type": "object"
    },
    "Baseline": {
      "additionalProperties": false,
      "properties": {
        "approval": {
          "$ref": "#/$defs/BaselineApproval"
        },
        "baseline_id": {
          "type": "string"
        },
        "created_by": {
          "$ref": "#/$defs/BaselineCreator"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "observation_contract_hash": {
          "type": "string"
        },
        "stability_runs": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "target_revision": {
          "type": "string"
        }
      },
      "required": [
        "baseline_id",
        "target_revision",
        "created_by",
        "approval",
        "observation_contract_hash"
      ],
      "type": "object"
    },
    "BaselineApproval": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/ApprovalStatus"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "BaselineCreator": {
      "enum": [
        "human",
        "policy",
        "imported"
      ],
      "type": "string"
    },
    "BehaviorCase": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "case_id": {
          "type": "string"
        },
        "comparison_policy": {
          "$ref": "#/$defs/ComparisonPolicy"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "fixture": {
          "$ref": "#/$defs/LocalFixture"
        },
        "required_observers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "schema_version": {
          "type": "string"
        },
        "timeout_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "case_id",
        "args",
        "environment",
        "timeout_ms",
        "fixture",
        "comparison_policy",
        "required_observers"
      ],
      "type": "object"
    },
    "BehaviorExperiment": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "$ref": "#/$defs/BehaviorTarget"
        },
        "baseline": {
          "$ref": "#/$defs/Baseline"
        },
        "before": {
          "$ref": "#/$defs/BehaviorTarget"
        },
        "case": {
          "$ref": "#/$defs/BehaviorCase"
        },
        "schema_version": {
          "type": "string"
        },
        "seed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "case",
        "baseline",
        "before",
        "after",
        "seed"
      ],
      "type": "object"
    },
    "BehaviorTarget": {
      "additionalProperties": false,
      "properties": {
        "executable": {
          "type": "string"
        },
        "identity": {
          "description": "SHA-256 of the actual executable bytes, not Git or a mutable label.",
          "type": "string"
        },
        "input_identity": {
          "type": "string"
        }
      },
      "required": [
        "executable",
        "identity",
        "input_identity"
      ],
      "type": "object"
    },
    "ComparisonPolicy": {
      "enum": [
        "process_byte_exact_v1"
      ],
      "type": "string"
    },
    "Divergence": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "$ref": "#/$defs/ObservableValue"
        },
        "after_run_id": {
          "type": "string"
        },
        "after_target_hash": {
          "type": "string"
        },
        "before": {
          "$ref": "#/$defs/ObservableValue"
        },
        "before_run_id": {
          "type": "string"
        },
        "before_target_hash": {
          "type": "string"
        },
        "case_identity": {
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "type": "array"
        },
        "observable": {
          "$ref": "#/$defs/Observable"
        }
      },
      "required": [
        "case_identity",
        "before_run_id",
        "after_run_id",
        "before_target_hash",
        "after_target_hash",
        "observable",
        "before",
        "after",
        "evidence_refs"
      ],
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_hash": {
          "type": "string"
        },
        "evidence_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "evidence_id",
        "evidence_hash"
      ],
      "type": "object"
    },
    "Failure": {
      "additionalProperties": false,
      "properties": {
        "comparison_id": {
          "type": "string"
        },
        "divergence": {
          "$ref": "#/$defs/Divergence"
        }
      },
      "required": [
        "comparison_id",
        "divergence"
      ],
      "type": "object"
    },
    "LocalFixture": {
      "additionalProperties": false,
      "properties": {
        "snapshot_identity": {
          "description": "Content/mode/directory snapshot identity, checked before either execution.",
          "type": "string"
        },
        "source": {
          "description": "None creates an empty workspace. stdin remains P1's /dev/null.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "snapshot_identity"
      ],
      "type": "object"
    },
    "Observable": {
      "enum": [
        "exit_code",
        "signal",
        "stdout",
        "stderr"
      ],
      "type": "string"
    },
    "ObservableValue": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "status",
              "type": "string"
            },
            "value": {
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "bytes",
              "type": "string"
            },
            "length": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "sha256": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "sha256",
            "length"
          ],
          "type": "object"
        }
      ]
    },
    "ReductionStatus": {
      "enum": [
        "MINIMIZED",
        "UNREDUCIBLE",
        "BUDGET_EXHAUSTED",
        "INCONCLUSIVE",
        "ERROR"
      ],
      "type": "string"
    },
    "Replayability": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "available",
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "reason": {
              "type": "string"
            },
            "status": {
              "const": "unavailable",
              "type": "string"
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "ReportKind": {
      "enum": [
        "behavior_exact",
        "behavior_stability",
        "generated_suite",
        "counterexample_reduction"
      ],
      "type": "string"
    },
    "Reproduction": {
      "additionalProperties": false,
      "properties": {
        "comparison": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "experiment": {
          "$ref": "#/$defs/BehaviorExperiment"
        },
        "label": {
          "type": "string"
        },
        "minimality_claim": {
          "type": [
            "string",
            "null"
          ]
        },
        "original_assignments": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "reduction_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReductionStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "retained_assignments": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "label",
        "comparison",
        "experiment"
      ],
      "type": "object"
    },
    "RunRecord": {
      "additionalProperties": false,
      "properties": {
        "config_hash": {
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "type": "array"
        },
        "initial_snapshot_identity": {
          "type": "string"
        },
        "input_identity": {
          "type": "string"
        },
        "plan_hash": {
          "type": "string"
        },
        "result_hash": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "working_directory": {
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "result_hash",
        "plan_hash",
        "config_hash",
        "input_identity",
        "initial_snapshot_identity",
        "working_directory",
        "evidence_refs"
      ],
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE",
        "ERROR"
      ],
      "type": "string"
    }
  },
  "$id": "https://b2ige.dev/schemas/verify/report-document.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "coverage": true,
    "evidence_summaries": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "type": "array"
    },
    "expected": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObservableValue"
        },
        {
          "type": "null"
        }
      ]
    },
    "headline": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ReportKind"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "observed": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObservableValue"
        },
        {
          "type": "null"
        }
      ]
    },
    "other_failures": {
      "items": {
        "$ref": "#/$defs/Failure"
      },
      "type": "array"
    },
    "outcome": {
      "type": "string"
    },
    "primary_failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/Failure"
        },
        {
          "type": "null"
        }
      ]
    },
    "product": {
      "type": "string"
    },
    "projection_version": {
      "const": "1",
      "type": "string"
    },
    "raw_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "reason": {
      "type": "string"
    },
    "related_artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "type": "array"
    },
    "replayability": {
      "$ref": "#/$defs/Replayability"
    },
    "report_id": {
      "type": "string"
    },
    "reproduction": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reproduction"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_references": {
      "items": {
        "$ref": "#/$defs/RunRecord"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "1",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    }
  },
  "required": [
    "schema_version",
    "projection_version",
    "report_id",
    "product",
    "kind",
    "source",
    "verdict",
    "outcome",
    "headline",
    "reason",
    "other_failures",
    "coverage",
    "evidence_summaries",
    "run_references",
    "limitations",
    "replayability",
    "related_artifacts",
    "raw_artifact"
  ],
  "title": "ReportDocument",
  "type": "object"
}
