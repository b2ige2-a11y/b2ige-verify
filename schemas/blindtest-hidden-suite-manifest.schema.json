{
  "$defs": {
    "ApprovedInvariantRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_hash": {
          "type": "string"
        },
        "checker_binding_hash": {
          "type": "string"
        },
        "invariant_id": {
          "type": "string"
        },
        "requirement_hash": {
          "type": "string"
        }
      },
      "required": [
        "invariant_id",
        "artifact_hash",
        "requirement_hash",
        "checker_binding_hash"
      ],
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ProvenanceStatus"
        }
      },
      "required": [
        "status",
        "source"
      ],
      "type": "object"
    },
    "ProvenanceStatus": {
      "enum": [
        "candidate",
        "reviewed",
        "approved",
        "authoritative"
      ],
      "type": "string"
    }
  },
  "$id": "https://b2ige.dev/schemas/verify/blindtest-hidden-suite-manifest.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approved_invariants": {
      "items": {
        "$ref": "#/$defs/ApprovedInvariantRef"
      },
      "type": "array"
    },
    "case_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "schema_version": {
      "const": "1",
      "type": "string"
    },
    "suite_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "suite_id",
    "version",
    "provenance",
    "approved_invariants",
    "case_hashes"
  ],
  "title": "BlindTestHiddenSuiteManifest",
  "type": "object"
}
