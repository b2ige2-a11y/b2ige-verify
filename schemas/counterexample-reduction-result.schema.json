{
  "$defs": {
    "ApprovalStatus": {
      "enum": [
        "approved",
        "unapproved"
      ],
      "type": "string"
    },
    "Assignment": {
      "additionalProperties": false,
      "properties": {
        "candidate_index": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "dimension_index": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "target": {
          "$ref": "#/$defs/DimensionTarget"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "dimension_index",
        "candidate_index",
        "target",
        "value"
      ],
      "type": "object"
    },
    "Attempt": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "assignment": {
          "items": {
            "$ref": "#/$defs/Assignment"
          },
          "type": "array"
        },
        "comparison": {
          "$ref": "#/$defs/ComparisonRef"
        },
        "outcome": {
          "$ref": "#/$defs/BehaviorOutcome"
        },
        "signature": {
          "anyOf": [
            {
              "$ref": "#/$defs/DivergenceSignature"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "assignment",
        "comparison",
        "outcome",
        "accepted"
      ],
      "type": "object"
    },
    "Baseline": {
      "additionalProperties": false,
      "properties": {
        "approval": {
          "$ref": "#/$defs/BaselineApproval"
        },
        "baseline_id": {
          "type": "string"
        },
        "created_by": {
          "$ref": "#/$defs/BaselineCreator"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "observation_contract_hash": {
          "type": "string"
        },
        "stability_runs": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "target_revision": {
          "type": "string"
        }
      },
      "required": [
        "baseline_id",
        "target_revision",
        "created_by",
        "approval",
        "observation_contract_hash"
      ],
      "type": "object"
    },
    "BaselineApproval": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/ApprovalStatus"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "BaselineCreator": {
      "enum": [
        "human",
        "policy",
        "imported"
      ],
      "type": "string"
    },
    "BehaviorCase": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "case_id": {
          "type": "string"
        },
        "comparison_policy": {
          "$ref": "#/$defs/ComparisonPolicy"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "fixture": {
          "$ref": "#/$defs/LocalFixture"
        },
        "required_observers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "schema_version": {
          "type": "string"
        },
        "timeout_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "case_id",
        "args",
        "environment",
        "timeout_ms",
        "fixture",
        "comparison_policy",
        "required_observers"
      ],
      "type": "object"
    },
    "BehaviorExperiment": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "$ref": "#/$defs/BehaviorTarget"
        },
        "baseline": {
          "$ref": "#/$defs/Baseline"
        },
        "before": {
          "$ref": "#/$defs/BehaviorTarget"
        },
        "case": {
          "$ref": "#/$defs/BehaviorCase"
        },
        "schema_version": {
          "type": "string"
        },
        "seed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "case",
        "baseline",
        "before",
        "after",
        "seed"
      ],
      "type": "object"
    },
    "BehaviorOutcome": {
      "enum": [
        "DIVERGENCE_PROVEN",
        "NO_DIVERGENCE_FOUND",
        "INCONCLUSIVE",
        "ERROR"
      ],
      "type": "string"
    },
    "BehaviorTarget": {
      "additionalProperties": false,
      "properties": {
        "executable": {
          "type": "string"
        },
        "identity": {
          "description": "SHA-256 of the actual executable bytes, not Git or a mutable label.",
          "type": "string"
        },
        "input_identity": {
          "type": "string"
        }
      },
      "required": [
        "executable",
        "identity",
        "input_identity"
      ],
      "type": "object"
    },
    "ComparisonPolicy": {
      "enum": [
        "process_byte_exact_v1"
      ],
      "type": "string"
    },
    "ComparisonRef": {
      "additionalProperties": false,
      "properties": {
        "comparison_hash": {
          "type": "string"
        },
        "comparison_id": {
          "type": "string"
        }
      },
      "required": [
        "comparison_id",
        "comparison_hash"
      ],
      "type": "object"
    },
    "Dimension": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/DimensionTarget"
        }
      },
      "required": [
        "target",
        "candidates"
      ],
      "type": "object"
    },
    "DimensionTarget": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "index": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "argument",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "index"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "environment",
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        }
      ]
    },
    "DivergenceSignature": {
      "additionalProperties": false,
      "description": "Exact ordered observable set, target pins, baseline and process semantics.\nStream bytes and status values may change; observable kinds may not change.",
      "properties": {
        "baseline_identity": {
          "type": "string"
        },
        "baseline_target_identity": {
          "type": "string"
        },
        "candidate_identity": {
          "type": "string"
        },
        "observables": {
          "items": {
            "$ref": "#/$defs/Observable"
          },
          "type": "array"
        },
        "policy": {
          "$ref": "#/$defs/ComparisonPolicy"
        }
      },
      "required": [
        "observables",
        "baseline_identity",
        "baseline_target_identity",
        "candidate_identity",
        "policy"
      ],
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_hash": {
          "type": "string"
        },
        "evidence_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "evidence_id",
        "evidence_hash"
      ],
      "type": "object"
    },
    "GeneratedCaseIdentity": {
      "additionalProperties": false,
      "properties": {
        "assignment": {
          "items": {
            "$ref": "#/$defs/Assignment"
          },
          "type": "array"
        },
        "case_identity": {
          "type": "string"
        },
        "generated_case_id": {
          "type": "string"
        },
        "generation_spec_hash": {
          "type": "string"
        },
        "input_identity": {
          "type": "string"
        },
        "parent_case_identity": {
          "type": "string"
        }
      },
      "required": [
        "generated_case_id",
        "parent_case_identity",
        "generation_spec_hash",
        "assignment",
        "input_identity",
        "case_identity"
      ],
      "type": "object"
    },
    "GenerationMode": {
      "enum": [
        "ONE_AT_A_TIME",
        "CARTESIAN"
      ],
      "type": "string"
    },
    "GenerationSpec": {
      "additionalProperties": false,
      "properties": {
        "base": {
          "$ref": "#/$defs/BehaviorExperiment",
          "description": "Includes the approved baseline and immutable execution/observation contract."
        },
        "dimensions": {
          "items": {
            "$ref": "#/$defs/Dimension"
          },
          "type": "array"
        },
        "generation_id": {
          "type": "string"
        },
        "max_cases": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "mode": {
          "$ref": "#/$defs/GenerationMode"
        },
        "schema_version": {
          "type": "string"
        }
      },
      "required": [
        "generation_id",
        "schema_version",
        "base",
        "mode",
        "dimensions",
        "max_cases"
      ],
      "type": "object"
    },
    "LocalFixture": {
      "additionalProperties": false,
      "properties": {
        "snapshot_identity": {
          "description": "Content/mode/directory snapshot identity, checked before either execution.",
          "type": "string"
        },
        "source": {
          "description": "None creates an empty workspace. stdin remains P1's /dev/null.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "snapshot_identity"
      ],
      "type": "object"
    },
    "Observable": {
      "enum": [
        "exit_code",
        "signal",
        "stdout",
        "stderr"
      ],
      "type": "string"
    },
    "ReductionInput": {
      "additionalProperties": false,
      "properties": {
        "execution_budget": {
          "description": "Maximum candidate P2 pair invocations (at most two process starts each).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expected_signature": {
          "$ref": "#/$defs/DivergenceSignature"
        },
        "failing_case": {
          "$ref": "#/$defs/GeneratedCaseIdentity"
        },
        "generation_spec": {
          "$ref": "#/$defs/GenerationSpec",
          "description": "Contains the original base case and its immutable execution contract."
        },
        "source_comparison": {
          "$ref": "#/$defs/ComparisonRef"
        },
        "source_suite_hash": {
          "type": "string"
        },
        "source_suite_id": {
          "type": "string"
        }
      },
      "required": [
        "source_suite_id",
        "source_suite_hash",
        "source_comparison",
        "failing_case",
        "generation_spec",
        "expected_signature",
        "execution_budget"
      ],
      "type": "object"
    },
    "ReductionStatus": {
      "enum": [
        "MINIMIZED",
        "UNREDUCIBLE",
        "BUDGET_EXHAUSTED",
        "INCONCLUSIVE",
        "ERROR"
      ],
      "type": "string"
    },
    "RunRecord": {
      "additionalProperties": false,
      "properties": {
        "config_hash": {
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "type": "array"
        },
        "initial_snapshot_identity": {
          "type": "string"
        },
        "input_identity": {
          "type": "string"
        },
        "plan_hash": {
          "type": "string"
        },
        "result_hash": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "working_directory": {
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "result_hash",
        "plan_hash",
        "config_hash",
        "input_identity",
        "initial_snapshot_identity",
        "working_directory",
        "evidence_refs"
      ],
      "type": "object"
    }
  },
  "$id": "https://b2ige.dev/schemas/verify/counterexample-reduction-result.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted_reductions": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "algorithm_version": {
      "type": "string"
    },
    "attempted_candidates": {
      "items": {
        "$ref": "#/$defs/Attempt"
      },
      "type": "array"
    },
    "authorization_hash": {
      "type": "string"
    },
    "execution_count": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "final_after": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunRecord"
        },
        {
          "type": "null"
        }
      ]
    },
    "final_before": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunRecord"
        },
        {
          "type": "null"
        }
      ]
    },
    "final_comparison": {
      "$ref": "#/$defs/ComparisonRef"
    },
    "final_evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "type": "array"
    },
    "final_signature": {
      "$ref": "#/$defs/DivergenceSignature"
    },
    "input": {
      "$ref": "#/$defs/ReductionInput"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "minimal": {
      "type": "boolean"
    },
    "minimality_claim": {
      "type": "string"
    },
    "original_assignment": {
      "items": {
        "$ref": "#/$defs/Assignment"
      },
      "type": "array"
    },
    "original_signature": {
      "$ref": "#/$defs/DivergenceSignature"
    },
    "reduced_assignment": {
      "items": {
        "$ref": "#/$defs/Assignment"
      },
      "type": "array"
    },
    "reduction_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ReductionStatus"
    },
    "trace_hash": {
      "type": "string"
    }
  },
  "required": [
    "reduction_id",
    "schema_version",
    "algorithm_version",
    "input",
    "authorization_hash",
    "original_assignment",
    "reduced_assignment",
    "original_signature",
    "final_signature",
    "attempted_candidates",
    "accepted_reductions",
    "execution_count",
    "status",
    "minimal",
    "minimality_claim",
    "final_comparison",
    "final_evidence_refs",
    "trace_hash",
    "limitations"
  ],
  "title": "CounterexampleReductionResult",
  "type": "object"
}
