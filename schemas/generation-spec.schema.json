{
  "$defs": {
    "ApprovalStatus": {
      "enum": [
        "approved",
        "unapproved"
      ],
      "type": "string"
    },
    "Baseline": {
      "additionalProperties": false,
      "properties": {
        "approval": {
          "$ref": "#/$defs/BaselineApproval"
        },
        "baseline_id": {
          "type": "string"
        },
        "created_by": {
          "$ref": "#/$defs/BaselineCreator"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "observation_contract_hash": {
          "type": "string"
        },
        "stability_runs": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "target_revision": {
          "type": "string"
        }
      },
      "required": [
        "baseline_id",
        "target_revision",
        "created_by",
        "approval",
        "observation_contract_hash"
      ],
      "type": "object"
    },
    "BaselineApproval": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/ApprovalStatus"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "BaselineCreator": {
      "enum": [
        "human",
        "policy",
        "imported"
      ],
      "type": "string"
    },
    "BehaviorCase": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "case_id": {
          "type": "string"
        },
        "comparison_policy": {
          "$ref": "#/$defs/ComparisonPolicy"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "fixture": {
          "$ref": "#/$defs/LocalFixture"
        },
        "required_observers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "schema_version": {
          "type": "string"
        },
        "timeout_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "case_id",
        "args",
        "environment",
        "timeout_ms",
        "fixture",
        "comparison_policy",
        "required_observers"
      ],
      "type": "object"
    },
    "BehaviorExperiment": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "$ref": "#/$defs/BehaviorTarget"
        },
        "baseline": {
          "$ref": "#/$defs/Baseline"
        },
        "before": {
          "$ref": "#/$defs/BehaviorTarget"
        },
        "case": {
          "$ref": "#/$defs/BehaviorCase"
        },
        "schema_version": {
          "type": "string"
        },
        "seed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "case",
        "baseline",
        "before",
        "after",
        "seed"
      ],
      "type": "object"
    },
    "BehaviorTarget": {
      "additionalProperties": false,
      "properties": {
        "executable": {
          "type": "string"
        },
        "identity": {
          "description": "SHA-256 of the actual executable bytes, not Git or a mutable label.",
          "type": "string"
        },
        "input_identity": {
          "type": "string"
        }
      },
      "required": [
        "executable",
        "identity",
        "input_identity"
      ],
      "type": "object"
    },
    "ComparisonPolicy": {
      "enum": [
        "process_byte_exact_v1"
      ],
      "type": "string"
    },
    "Dimension": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/DimensionTarget"
        }
      },
      "required": [
        "target",
        "candidates"
      ],
      "type": "object"
    },
    "DimensionTarget": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "index": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "argument",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "index"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "environment",
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        }
      ]
    },
    "GenerationMode": {
      "enum": [
        "ONE_AT_A_TIME",
        "CARTESIAN"
      ],
      "type": "string"
    },
    "LocalFixture": {
      "additionalProperties": false,
      "properties": {
        "snapshot_identity": {
          "description": "Content/mode/directory snapshot identity, checked before either execution.",
          "type": "string"
        },
        "source": {
          "description": "None creates an empty workspace. stdin remains P1's /dev/null.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "snapshot_identity"
      ],
      "type": "object"
    }
  },
  "$id": "https://b2ige.dev/schemas/verify/generation-spec.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base": {
      "$ref": "#/$defs/BehaviorExperiment",
      "description": "Includes the approved baseline and immutable execution/observation contract."
    },
    "dimensions": {
      "items": {
        "$ref": "#/$defs/Dimension"
      },
      "type": "array"
    },
    "generation_id": {
      "type": "string"
    },
    "max_cases": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "mode": {
      "$ref": "#/$defs/GenerationMode"
    },
    "schema_version": {
      "const": "1",
      "type": "string"
    }
  },
  "required": [
    "generation_id",
    "schema_version",
    "base",
    "mode",
    "dimensions",
    "max_cases"
  ],
  "title": "GenerationSpec",
  "type": "object"
}
