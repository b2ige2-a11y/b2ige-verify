{
  "schema_version": 1,
  "branch": "automation/100-point",
  "remote": "origin",
  "default_goal": "Complete the B2IGE Verify 100-point roadmap end-to-end, preserving and strengthening false-PASS resistance, evidence-backed deterministic verdicts, isolation boundaries, reproducibility, usability, and public proof.",
  "models": {
    "default": {
      "model": "gpt-5.6-luna",
      "reasoning": "max"
    },
    "advanced": {
      "model": "gpt-6-astra",
      "reasoning": "medium"
    },
    "critical": {
      "model": "gpt-6-astra",
      "reasoning": "xhigh"
    }
  },
  "max_worker_attempts": 4,
  "max_remediation_cycles": 3,
  "gate_timeout_seconds": 3600,
  "final_gate_timeout_seconds": 7200,
  "push_each_package": true,
  "auto_merge_main": false
}
