{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approved",
    "summary",
    "issues",
    "remediation_work_packages"
  ],
  "properties": {
    "approved": {
      "type": "boolean"
    },
    "summary": {
      "type": "string"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remediation_work_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "phase",
          "title",
          "risk",
          "objective",
          "acceptance_criteria"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "risk": {
            "type": "string",
            "enum": [
              "default",
              "advanced",
              "critical"
            ]
          },
          "objective": {
            "type": "string"
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
